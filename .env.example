PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/int_messager

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# Public address users open in their browser. For local development:
APP_BASE_URL=http://localhost:3001
PASSWORD_RESET_EXPIRES_MINUTES=20

# SMTP email settings. Example values work with many providers after replacing them.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Int-Messager <no-reply@example.com>

# Existing optional values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
